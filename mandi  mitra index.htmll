{id:'bajra',n:['बाजरा','Bajra (pearl millet)','बाजरी','બાજરી','ਬਾਜਰਾ'],base:2400,agm:'Bajra(Pearl Millet/Cumbu)',syn:['बाजरा','बाजरी','bajra','bajri','બાજરી','ਬਾਜਰਾ']},
{id:'gram',n:['चना','Gram (chickpea)','हरभरा','ચણા','ਛੋਲੇ'],base:5600,agm:'Bengal Gram(Gram)(Whole)',syn:['चना','chana','gram','chickpea','हरभरा','ચણા','ਛੋਲੇ','ਚਣਾ']},
{id:'soybean',n:['सोयाबीन','Soybean','सोयाबीन','સોયાબીન','ਸੋਇਆਬੀਨ'],base:4800,agm:'Soyabean',syn:['सोयाबीन','soybean','soyabean','soya','સોયાબીન','ਸੋਇਆਬੀਨ']},
{id:'maize',n:['मक्का','Maize','मका','મકાઈ','ਮੱਕੀ'],base:2200,agm:'Maize',syn:['मक्का','makka','maize','corn','मका','મકાઈ','ਮੱਕੀ']},
{id:'paddy',n:['धान','Paddy (rice)','भात (धान)','ડાંગર','ਝੋਨਾ'],base:2300,agm:'Paddy(Dhan)(Common)',syn:['धान','dhan','paddy','rice','ડાંગર','ਝੋਨਾ']},
{id:'moong',n:['मूंग','Moong','मूग','મગ','ਮੂੰਗੀ'],base:7600,agm:'Green Gram (Moong)(Whole)',syn:['मूंग','moong','mung','मूग','મગ','ਮੂੰਗੀ']}
];
var SYNX={wheat:['গম','ଗହମ','గోధుమ','ಗೋಧಿ','godhuma','gahum','godhi'],mustard:['সরষে','সর্ষে','ସୋରିଷ','ఆవాలు','ಸಾಸಿವೆ','sorse','sorisha','avalu','sasive'],bajra:['বাজরা','ବାଜରା','సజ్జలు','ಸಜ್ಜೆ','sajjalu','sajje'],gram:['ছোলা','ବୁଟ','శనగలు','ಕಡಲೆ','chhola','sanagalu','kadale'],soybean:['সয়াবিন','ସୋୟାବିନ','సోయాబీన్','ಸೋಯಾಬೀನ್'],maize:['ভুট্টা','ମକା','మొక్కజొన్న','ಮೆಕ್ಕೆಜೋಳ','bhutta','mokkajonna'],paddy:['ধান','ଧାନ','వరి','ధాన్యం','ಭತ್ತ','bhatta'],moong:['মুগ','ମୁଗ','పెసలు','ಹೆಸರು','pesalu','hesaru']};
CROPS.forEach(function(c){c.syn=c.syn.concat(SYNX[c.id]||[])});
var VEH={tempo:{cap:15,perkm:18},tractor:{cap:40,perkm:15},truck:{cap:100,perkm:32}};
var DEFM=[
{id:'m1',names:['जयपुर (मुहाना)','Jaipur (Muhana)','जयपूर (मुहाना)','જયપુર (મુહાના)','ਜੈਪੁਰ (ਮੁਹਾਨਾ)'],key:'jaipur',dist:28,off:0},
{id:'m2',names:['दौसा','Dausa','दौसा','દૌસા','ਦੌਸਾ'],key:'dausa',dist:52,off:-0.012},
{id:'m3',names:['टोंक','Tonk','टोंक','ટોંક','ਟੋਂਕ'],key:'tonk',dist:74,off:-0.02},
{id:'m4',names:['सीकर','Sikar','सीकर','સીકર','ਸੀਕਰ'],key:'sikar',dist:96,off:0.015},
{id:'m5',names:['अजमेर','Ajmer','अजमेर','અજમેર','ਅਜਮੇਰ'],key:'ajmer',dist:132,off:0.01},
{id:'h0',home:true,names:null,key:'',dist:0,off:-0.045}
];
var KEY='mandi-saathi-v1';
var state={lang:'hi',crop:'wheat',qty:50,unit:'q',vehicle:'tractor',cap:40,perkm:15,round:true,comm:2,fee:1,hamali:6,other:150,cult:70000,whatif:0,mandis:[],rates:{},apiKey:'',liveState:'Rajasthan'};
function r5(x){return Math.round(x/5)*5}
function seed(){
  state.mandis=DEFM.map(function(m){return {id:m.id,names:m.names,key:m.key,dist:m.dist,home:!!m.home,custom:null}});
  state.rates={};
  DEFM.forEach(function(m){state.rates[m.id]={};CROPS.forEach(function(c){state.rates[m.id][c.id]={v:r5(c.base*(1+m.off)),src:'sample'}})});
}
seed();
try{var saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved&&saved.mandis&&saved.rates){for(var k in saved){state[k]=saved[k]}}}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){}}

var $=function(id){return document.getElementById(id)};
function baseL(){return IX[state.lang]!=null?state.lang:(FB[state.lang]||'en')}
function t(k){var o=OV[state.lang];if(o&&o[k]!=null)return o[k];var a=S[k];return a?a[IX[baseL()]]:k}
function cName(c){var o=CN[state.lang];return (o&&o[c.id])||c.n[IX[baseL()]]}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function fmt(n){return (n<0?'−':'')+'₹'+Math.round(Math.abs(n)).toLocaleString('en-IN')}
function num(n,d){return (Math.round(n*Math.pow(10,d||0))/Math.pow(10,d||0)).toLocaleString('en-IN')}
function cropObj(){return CROPS.filter(function(c){return c.id===state.crop})[0]||CROPS[0]}
function mName(m){if(m.custom)return m.custom;if(m.home)return t('home');var o=MN[state.lang];return (o&&o[m.id])||m.names[IX[baseL()]]}
function rateOf(m){var r=state.rates[m.id]=state.rates[m.id]||{};return r[state.crop]=r[state.crop]||{v:r5(cropObj().base),src:'mine'}}
function qq(){var q=+state.qty||0;return state.unit==='kg'?q/100:state.unit==='t'?q*10:q}

/* ---------- static text, selects ---------- */
var ICON_MIC='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>';
function applyText(){
  document.documentElement.lang=state.lang;
  document.querySelectorAll('[data-i18n]').forEach(function(el){el.textContent=t(el.getAttribute('data-i18n'))});
  $('langs').innerHTML=LANGS.map(function(l){return '<button type="button" data-l="'+l[0]+'" aria-pressed="'+(l[0]===state.lang)+'">'+l[1]+(l[3]?'<sup>beta</sup>':'')+'</button>'}).join('');
  $('crop').innerHTML=CROPS.map(function(c){return '<option value="'+c.id+'"'+(c.id===state.crop?' selected':'')+'>'+esc(cName(c))+'</option>'}).join('');
  $('unit').innerHTML=[['q','u_q'],['kg','u_kg'],['t','u_t']].map(function(u){return '<option value="'+u[0]+'"'+(u[0]===state.unit?' selected':'')+'>'+t(u[1])+'</option>'}).join('');
  $('vehicle').innerHTML=[['tempo','v_tempo'],['tractor','v_tractor'],['truck','v_truck']].map(function(u){return '<option value="'+u[0]+'"'+(u[0]===state.vehicle?' selected':'')+'>'+t(u[1])+'</option>'}).join('');
  document.querySelectorAll('[data-mic]').forEach(function(b){b.innerHTML=ICON_MIC});
  $('mic').setAttribute('aria-label',t('mic_hint'));
}
var FIELDS=['qty','cap','perkm','comm','fee','hamali','other','cult'];
function fillInputs(){
  FIELDS.forEach(function(f){$(f).value=state[f]});
  $('round').checked=!!state.round;$('whatif').value=state.whatif;
  $('apiKey').value=state.apiKey||'';$('liveState').value=state.liveState||'Rajasthan';
}

/* ---------- mandi list ---------- */
function renderMandis(){
  $('mlist').innerHTML=state.mandis.map(function(m){
    var r=rateOf(m);
    return '<div class="mrow" data-id="'+m.id+'"><div class="mname"><b>'+esc(mName(m))+'</b><span class="pill '+r.src+'" data-pill>'+pillText(r)+'</span></div>'+
    '<label class="f"><span>'+t('m_dist')+'</span><input type="number" inputmode="decimal" min="0" data-f="dist" value="'+m.dist+'"'+(m.home?' disabled':'')+'></label>'+
    '<label class="f"><span>'+t('m_rate')+'</span><input type="number" inputmode="decimal" min="0" data-f="rate" value="'+r.v+'"></label>'+
    (m.home?'<span></span>':'<button class="ghost" type="button" data-del>'+t('del')+'</button>')+'</div>';
  }).join('');
}
function pillText(r){return r.src==='live'?t('t_live')+(r.date?' '+esc(r.date):''):r.src==='mine'?t('t_mine'):t('t_sample')}

/* ---------- calculation ---------- */
function compute(){
  var q=qq(),pc=(+state.comm||0)+(+state.fee||0),cult=+state.cult||0,f=1+(+state.whatif||0)/100;
  var rows=state.mandis.map(function(m){
    var rate=rateOf(m).v*f,gross=q*rate,h=m.home;
    var pct=h?0:gross*pc/100,lab=h?0:q*(+state.hamali||0),oth=h?0:(+state.other||0);
    var trips=h?0:Math.ceil(q/(+state.cap||1)),tr=h?0:trips*(+m.dist||0)*(state.round?2:1)*(+state.perkm||0);
    var ded=pct+lab+oth,net=gross-tr-ded,profit=net-cult;
    var den=q*(1-(h?0:pc/100));
    var be=den>0?(cult+tr+lab+oth)/den/f:0;
    return {m:m,rate:rate,gross:gross,tr:tr,trips:trips,ded:ded,net:net,profit:profit,main:cult>0?profit:net,perq:q>0?net/q:0,be:be};
  });
  rows.sort(function(a,b){return b.net-a.net});
  return rows;
}
var last=null;
function renderResults(){
  var rows=compute();last=rows;var q=qq(),cult=+state.cult||0;
  $('whatifVal').textContent=(state.whatif>0?'+':'')+state.whatif+'%';
  if(!rows.length||q<=0){$('best').innerHTML='';$('cards').innerHTML='';$('bars').innerHTML='';$('table').innerHTML='';return}
  var b=rows[0],w=rows[rows.length-1],isLoss=b.main<0;
  var lbl=cult>0?(b.profit>=0?t('profit'):t('loss')):t('net_hand');
  $('best').innerHTML='<div class="best'+(isLoss?' loss':'')+'"><small>'+t('best')+'</small><div class="where">'+esc(mName(b.m))+'</div>'+
   '<div class="big">'+fmt(b.main)+'</div><small>'+lbl+'</small>'+
   '<div class="meta"><span>'+t('net_hand')+': '+fmt(b.net)+'</span><span>'+t('transp')+': '+fmt(b.tr)+'</span>'+
   (rows.length>1?'<span>'+t('gap')+': '+fmt(b.net-w.net)+'</span>':'')+'</div></div>';
  $('cards').innerHTML=rows.map(function(r,i){
    var cls=r.main>=0?'gain':'lossc',l=cult>0?(r.profit>=0?t('profit'):t('loss')):t('net_hand');
    return '<article class="card'+(i===0?' top':'')+'"><div class="chead"><span class="rank">'+(i+1)+'</span><div><h3>'+esc(mName(r.m))+'</h3><p>'+(r.m.home?'':num(r.m.dist)+' '+t('km')+' · ')+'₹'+num(r.rate)+' / '+t('u_q')+'</p></div>'+
    '<div class="cmain"><small>'+l+'</small><b class="'+cls+'">'+fmt(r.main)+'</b></div></div>'+
    '<dl class="kv"><div><dt>'+t('gross')+'</dt><dd>'+fmt(r.gross)+'</dd></div>'+
    '<div><dt>'+t('transp')+(r.trips?' ('+r.trips+' '+t('trips')+')':'')+'</dt><dd>'+fmt(r.tr)+'</dd></div>'+
    '<div><dt>'+t('deduct')+'</dt><dd>'+fmt(r.ded)+'</dd></div>'+
    '<div><dt>'+t('net_hand')+'</dt><dd>'+fmt(r.net)+'</dd></div>'+
    '<div><dt>'+t('perq')+'</dt><dd>'+fmt(r.perq)+'</dd></div>'+
    (cult>0?'<div><dt>'+t('breakeven')+'</dt><dd>₹'+num(r.be)+' / '+t('u_q')+'</dd></div>':'')+'</dl>'+
    (i>0?'<p class="less">'+t('vs_best')+': '+fmt(b.net-r.net)+'</p>':'')+'</article>';
  }).join('');
  var vals=rows.map(function(r){return r.main}),mn=Math.min.apply(null,vals.concat([0])),mx=Math.max.apply(null,vals.concat([0])),span=(mx-mn)||1,z=(-mn)/span*100;
  $('bars').innerHTML=rows.map(function(r){
    var wd=Math.abs(r.main)/span*100,l=r.main>=0?z:z-wd,cls=r.main>=0?'gain':'lossc';
    return '<div><div class="bhead"><span>'+esc(mName(r.m))+'</span><b class="'+cls+'">'+fmt(r.main)+'</b></div><div class="track"><i class="zero" style="left:'+z+'%"></i><i class="bar '+cls+'" style="left:'+l+'%;width:'+wd+'%"></i></div></div>';
  }).join('');
  $('table').innerHTML='<table><thead><tr><th>'+t('m_name')+'</th><th>'+t('km')+'</th><th>'+t('th_rate')+'</th><th>'+t('gross')+'</th><th>'+t('transp')+'</th><th>'+t('th_ded')+'</th><th>'+t('th_net')+'</th><th>'+t('th_pl')+'</th></tr></thead><tbody>'+
  rows.map(function(r){var cls=r.main>=0?'gain':'lossc';return '<tr><td>'+esc(mName(r.m))+'</td><td>'+(r.m.home?'–':num(r.m.dist))+'</td><td>'+num(r.rate)+'</td><td>'+num(r.gross)+'</td><td>'+num(r.tr)+'</td><td>'+num(r.ded)+'</td><td>'+num(r.net)+'</td><td class="'+cls+'"><b>'+fmt(r.main)+'</b></td></tr>'}).join('')+'</tbody></table>';
  save();
}

/* ---------- speech out ---------- */
function sayText(b,cult){
  var L=state.lang,m=mName(b.m),c=cName(cropObj()),q=num(qq(),1),n=Math.round(b.net),p=Math.round(Math.abs(b.profit)),pr=b.profit>=0,cu=cult>0;
  if(SAY[L])return SAY[L](m,c,q,n,p,pr,cu);
  if(IX[L]==null)L=FB[L]||'en';
  if(L==='hi')return 'सबसे अच्छी जगह '+m+' है। '+q+' क्विंटल '+c+' बेचकर, सारे खर्च के बाद '+n+' रुपये हाथ में आएंगे। '+(cu?(pr?'इसमें '+p+' रुपये मुनाफ़ा है।':'लेकिन '+p+' रुपये का नुकसान है।'):'');
  if(L==='mr')return 'सर्वात चांगली जागा '+m+' आहे. '+q+' क्विंटल '+c+' विकून सर्व खर्चानंतर '+n+' रुपये हातात येतील. '+(cu?(pr?'यात '+p+' रुपये नफा आहे.':'पण '+p+' रुपये तोटा आहे.'):'');
  if(L==='gu')return 'સૌથી સારી જગ્યા '+m+' છે. '+q+' ક્વિન્ટલ '+c+' વેચતાં બધા ખર્ચ પછી '+n+' રૂપિયા હાથમાં આવશે. '+(cu?(pr?'તેમાં '+p+' રૂપિયા નફો છે.':'પણ '+p+' રૂપિયાનું નુકસાન છે.'):'');
  if(L==='pa')return 'ਸਭ ਤੋਂ ਵਧੀਆ ਥਾਂ '+m+' ਹੈ। '+q+' ਕੁਇੰਟਲ '+c+' ਵੇਚ ਕੇ, ਸਾਰੇ ਖ਼ਰਚਿਆਂ ਤੋਂ ਬਾਅਦ '+n+' ਰੁਪਏ ਹੱਥ ਵਿੱਚ ਆਉਣਗੇ। '+(cu?(pr?'ਇਸ ਵਿੱਚ '+p+' ਰੁਪਏ ਮੁਨਾਫ਼ਾ ਹੈ।':'ਪਰ '+p+' ਰੁਪਏ ਦਾ ਘਾਟਾ ਹੈ।'):'');
  return 'The best place to sell is '+m+'. Selling '+q+' quintal of '+c+', you take home '+n+' rupees after all expenses. '+(cu?(pr?'That is a profit of '+p+' rupees.':'That is a loss of '+p+' rupees.'):'');
}
function speak(){
  if(!last||!last.length||!('speechSynthesis' in window))return;
  try{
    window.speechSynthesis.cancel();
    var u=new SpeechSynthesisUtterance(sayText(last[0],+state.cult||0));
    u.lang=sttLang();u.rate=.9;window.speechSynthesis.speak(u);
  }catch(e){}
}

/* ---------- voice in ---------- */
function dg(s){
  var bases=[[0x966,0x96F],[0xAE6,0xAEF],[0xA66,0xA6F],[0x9E6,0x9EF],[0xB66,0xB6F],[0xC66,0xC6F],[0xCE6,0xCEF]];
  return s.replace(/[०-९૦-૯੦-੯০-৯୦-୯౦-౯೦-೯]/g,function(c){
    var code=c.charCodeAt(0);for(var i=0;i<bases.length;i++){if(code>=bases[i][0]&&code<=bases[i][1])return String(code-bases[i][0])}return c});
}
function firstNum(s){var m=dg(s).replace(/,/g,'').match(/\d+(\.\d+)?/);return m?parseFloat(m[0]):null}
function listen(btn,onText){
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition,heard=$('heard');
  if(!SR){heard.textContent=t('novoice');return}
  var r;
  try{r=new SR();r.lang=sttLang();r.interimResults=false;r.maxAlternatives=1}catch(e){heard.textContent=t('novoice');return}
  btn.classList.add('on');heard.textContent=t('listening');
  r.onresult=function(e){var tx=e.results[0][0].transcript;heard.textContent=t('heard')+' '+tx;onText(tx)};
  r.onerror=function(){heard.textContent=t('novoice')};
  r.onend=function(){btn.classList.remove('on')};
  try{r.start()}catch(e){btn.classList.remove('on');heard.textContent=t('novoice')}
}
function setField(id,v){$(id).value=v;state[id]=v;renderResults()}
function voiceAll(tx){
  var low=tx.toLowerCase(),found=null;
  CROPS.forEach(function(c){c.syn.forEach(function(s){if(!found&&low.indexOf(s.toLowerCase())>-1)found=c})});
  var n=firstNum(tx);
  if(found){state.crop=found.id;$('crop').value=found.id;renderMandis()}
  if(n!==null){
    if(/किलो|kg|kilo|કિલો|ਕਿਲੋ|কেজি|କିଲୋ|కిలో|ಕಿಲೋ/i.test(tx)){state.unit='kg';$('unit').value='kg'}
    else if(/टन|ton|ટન|ਟਨ|টন|ଟନ|టన్|ಟನ್/i.test(tx)){state.unit='t';$('unit').value='t'}
    else if(/क्विंटल|quintal|ક્વિન્ટલ|ਕੁਇੰਟਲ|কুইন্টাল|କ୍ୱିଣ୍ଟାଲ|క్వింటాల్|ಕ್ವಿಂಟಾಲ್|kwintal|quintle/i.test(tx)){state.unit='q';$('unit').value='q'}
    setField('qty',n);
  }else if(!found){$('heard').textContent=t('heard')+' '+tx+' — '+t('nonum');return}
  else renderResults();
  setTimeout(speak,300);
}

/* ---------- live rates ---------- */
function liveFetch(){
  var msg=$('liveMsg'),key=$('apiKey').value.trim();
  state.apiKey=key;state.liveState=$('liveState').value.trim()||'Rajasthan';save();
  if(!key){msg.textContent=t('live_nokey');return}
  msg.textContent=t('live_wait');
  var url='https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070?api-key='+encodeURIComponent(key)+'&format=json&limit=1000&filters%5Bstate%5D='+encodeURIComponent(state.liveState)+'&filters%5Bcommodity%5D='+encodeURIComponent(cropObj().agm);
  fetch(url).then(function(r){if(!r.ok)throw new Error(r.status);return r.json()}).then(function(j){
    var recs=j.records||[],hit=0;
    state.mandis.forEach(function(m){
      if(m.home)return;
      var k=(m.key||(m.custom||'').toLowerCase().split(/[\s(]/)[0]);if(!k)return;
      var rec=recs.filter(function(x){return String(x.market||'').toLowerCase().indexOf(k)>-1})[0];
      if(rec&&+rec.modal_price>0){state.rates[m.id][state.crop]={v:+rec.modal_price,src:'live',date:String(rec.arrival_date||'').slice(0,5)};hit++}
    });
    renderMandis();renderResults();
    msg.textContent=hit?t('live_ok')+' '+hit:t('live_none');
  }).catch(function(){msg.textContent=t('live_fail')});
}

/* ---------- events ---------- */
$('langs').addEventListener('click',function(e){var b=e.target.closest('button[data-l]');if(!b)return;state.lang=b.getAttribute('data-l');applyText();renderMandis();renderResults()});
$('crop').addEventListener('change',function(){state.crop=this.value;renderMandis();renderResults()});
$('unit').addEventListener('change',function(){state.unit=this.value;renderResults()});
$('vehicle').addEventListener('change',function(){state.vehicle=this.value;var v=VEH[this.value];state.cap=v.cap;state.perkm=v.perkm;$('cap').value=v.cap;$('perkm').value=v.perkm;renderResults()});
FIELDS.forEach(function(f){$(f).addEventListener('input',function(){state[f]=this.value===''?0:+this.value;renderResults()})});
$('round').addEventListener('change',function(){state.round=this.checked;renderResults()});
$('whatif').addEventListener('input',function(){state.whatif=+this.value;renderResults()});
$('mlist').addEventListener('input',function(e){
  var inp=e.target,row=inp.closest('.mrow');if(!row)return;
  var m=state.mandis.filter(function(x){return x.id===row.getAttribute('data-id')})[0];if(!m)return;
  var v=inp.value===''?0:+inp.value;
  if(inp.getAttribute('data-f')==='dist'){m.dist=v}
  else{state.rates[m.id][state.crop]={v:v,src:'mine'};var p=row.querySelector('[data-pill]');p.className='pill mine';p.textContent=t('t_mine')}
  renderResults();
});
$('mlist').addEventListener('click',function(e){
  var b=e.target.closest('[data-del]');if(!b)return;
  var id=b.closest('.mrow').getAttribute('data-id');
  state.mandis=state.mandis.filter(function(x){return x.id!==id});renderMandis();renderResults();
});
$('addBtn').addEventListener('click',function(){
  var name=$('newName').value.trim();if(!name)return;
  var id='u'+Date.now(),sum=0,n=0;
  state.mandis.forEach(function(m){if(!m.home){sum+=rateOf(m).v;n++}});
  state.mandis.splice(state.mandis.length-1>=0&&state.mandis[state.mandis.length-1].home?state.mandis.length-1:state.mandis.length,0,{id:id,names:null,key:'',dist:+$('newDist').value||0,home:false,custom:name});
  state.rates[id]={};CROPS.forEach(function(c){var s=0,k=0;state.mandis.forEach(function(m){if(!m.home&&m.id!==id&&state.rates[m.id]&&state.rates[m.id][c.id]){s+=state.rates[m.id][c.id].v;k++}});state.rates[id][c.id]={v:r5(k?s/k:c.base),src:'mine'}});
  $('newName').value='';$('newDist').value='';renderMandis();renderResults();
});
$('liveBtn').addEventListener('click',liveFetch);
$('speakBtn').addEventListener('click',speak);
$('mic').addEventListener('click',function(){listen(this,voiceAll)});
document.querySelectorAll('[data-mic]').forEach(function(b){b.addEventListener('click',function(){
  var f=b.getAttribute('data-mic');
  listen(b,function(tx){var n=firstNum(tx);if(n===null){$('heard').textContent=t('heard')+' '+tx+' — '+t('nonum');return}setField(f,n)});
})});

applyText();fillInputs();renderMandis();renderResults();
})();
</script>
</body></html>
