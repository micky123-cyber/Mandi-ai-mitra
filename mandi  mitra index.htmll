<!doctype html><html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light}html,body{margin:0}</style></head><body>
<title>Mandi Saathi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Mukta:wght@400;600;700&family=Noto+Sans+Gujarati:wght@400;600;700&family=Noto+Sans+Gurmukhi:wght@400;600;700&family=Noto+Sans+Bengali:wght@400;600;700&family=Noto+Sans+Oriya:wght@400;600;700&family=Noto+Sans+Telugu:wght@400;600;700&family=Noto+Sans+Kannada:wght@400;600;700&display=swap">
<style>
/* Layout: a workbench. Inputs stack on the left, the live verdict stays on the right; on phones it is one column, inputs first, verdict after. */
:root{
  --bg:#EEF2EA; --surface:#FFFFFF; --field:#F5F8F2; --ink:#16251B; --muted:#56675B; --line:#D2DBCE;
  --accent:#1F6B3A; --accent-ink:#FFFFFF; --focus:#1F6B3A;
  --gain:#17773F; --gain-bg:#DDF1E3; --loss:#B3342A; --loss-bg:#F8E0DD; --gold:#9A6700; --gold-bg:#F6E8C3;
  --best-bg:#1F6B3A; --best-ink:#FFFFFF; --bestloss-bg:#A52F26; --bestloss-ink:#FFFFFF;
  --f-body:"Mukta","Noto Sans Gujarati","Noto Sans Gurmukhi","Noto Sans Bengali","Noto Sans Oriya","Noto Sans Telugu","Noto Sans Kannada",system-ui,sans-serif;
  --f-display:"Baloo 2","Mukta","Noto Sans Gujarati","Noto Sans Gurmukhi","Noto Sans Bengali","Noto Sans Oriya","Noto Sans Telugu","Noto Sans Kannada",system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0E1912; --surface:#16231A; --field:#1D2D21; --ink:#E5EFE4; --muted:#9BAF9F; --line:#2B3C2F;
  --accent:#5FBF82; --accent-ink:#0E1912; --focus:#7BD69C;
  --gain:#6BD593; --gain-bg:#173824; --loss:#F28F83; --loss-bg:#3C1E1A; --gold:#E6B23C; --gold-bg:#3A2F12;
  --best-bg:#1D5233; --best-ink:#E8F6EC; --bestloss-bg:#6E2A23; --bestloss-ink:#FBE8E5; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0E1912; --surface:#16231A; --field:#1D2D21; --ink:#E5EFE4; --muted:#9BAF9F; --line:#2B3C2F;
  --accent:#5FBF82; --accent-ink:#0E1912; --focus:#7BD69C;
  --gain:#6BD593; --gain-bg:#173824; --loss:#F28F83; --loss-bg:#3C1E1A; --gold:#E6B23C; --gold-bg:#3A2F12;
  --best-bg:#1D5233; --best-ink:#E8F6EC; --bestloss-bg:#6E2A23; --bestloss-ink:#FBE8E5; color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.5;padding-inline:16px;padding-block:20px 40px}
h1,h2,h3{font-family:var(--f-display);margin:0;line-height:1.15;text-wrap:balance}
button,input,select{font:inherit;color:inherit}
.shell{max-width:1120px;margin-inline:auto;display:flex;flex-direction:column;gap:18px}
.head{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:flex-end;justify-content:space-between}
.head h1{font-size:2.1rem;font-weight:800;color:var(--accent)}
.tag{margin:2px 0 0;color:var(--muted)}
.langs{display:flex;flex-wrap:wrap;gap:6px}
.langs button{min-height:44px;padding:0 12px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);cursor:pointer}
.langs button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:700}
:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.langs sup{font-size:.62rem;opacity:.75;margin-left:3px;letter-spacing:.04em}

.cols{display:grid;grid-template-columns:minmax(0,1fr);gap:18px}
@media (min-width:920px){.cols{grid-template-columns:minmax(0,5fr) minmax(0,6fr);align-items:start}.col-out{position:sticky;top:12px}}
.col-in,.col-out{display:flex;flex-direction:column;gap:16px;min-width:0}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:14px;min-width:0}
.panel h2{font-size:1.25rem;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
label.f{display:flex;flex-direction:column;gap:4px;min-width:0}
label.f>span{font-size:.85rem;color:var(--muted);line-height:1.25}
input[type=number],input[type=text],select{width:100%;min-width:0;min-height:48px;padding:0 12px;border:1.5px solid var(--line);border-radius:8px;background:var(--field)}
input[type=range]{width:100%;accent-color:var(--accent)}
.row{display:flex;gap:6px;align-items:stretch}
.row>input,.row>select{flex:1}
.check{display:flex;gap:10px;align-items:center;min-height:48px}
.check input{width:22px;height:22px;accent-color:var(--accent)}
.iconbtn{flex:0 0 48px;min-height:48px;border-radius:8px;border:1.5px solid var(--line);background:var(--surface);color:var(--accent);cursor:pointer;display:grid;place-items:center}
.iconbtn.on{background:var(--accent);color:var(--accent-ink)}
.iconbtn svg{width:22px;height:22px}

.voice{flex-direction:row;align-items:center;gap:16px}
.mic{flex:0 0 76px;width:76px;height:76px;border-radius:50%;border:0;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;cursor:pointer}
.mic svg{width:34px;height:34px}
.mic.on{animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 50%,transparent)}50%{box-shadow:0 0 0 14px transparent}}
@media (prefers-reduced-motion:reduce){.mic.on{animation:none;outline:4px solid var(--gold)}}
.voice p{margin:0;min-width:0}
.hint{color:var(--muted);font-size:.95rem}
#heard{font-weight:600;min-height:1.5em}

.note{margin:0;padding:10px 12px;border-radius:8px;background:var(--gold-bg);color:var(--ink);font-size:.92rem}
.mrow{display:grid;grid-template-columns:1fr 1fr auto;gap:8px;align-items:end;padding-block:12px;border-top:1px solid var(--line)}
.mrow:first-of-type{border-top:0}
.mname{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.mname b{font-family:var(--f-display);font-size:1.1rem}
.pill{font-size:.72rem;font-weight:700;letter-spacing:.06em;padding:2px 8px;border-radius:999px;background:var(--field);color:var(--muted);border:1px solid var(--line)}
.pill.live{background:var(--gain-bg);color:var(--gain);border-color:transparent}
.pill.mine{background:var(--gold-bg);color:var(--gold);border-color:transparent}
.ghost{min-height:48px;padding:0 12px;border-radius:8px;border:1.5px solid var(--line);background:transparent;color:var(--muted);cursor:pointer}
.btn{min-height:48px;padding:0 18px;border-radius:8px;border:0;background:var(--accent);color:var(--accent-ink);font-weight:700;cursor:pointer}
.btn.alt{background:transparent;color:var(--accent);border:1.5px solid var(--accent)}
.addrow{display:grid;grid-template-columns:2fr 1fr auto;gap:8px;align-items:end}
@media (max-width:480px){.addrow{grid-template-columns:1fr 1fr}.addrow .btn{grid-column:1/-1}}
details summary{cursor:pointer;font-weight:600;min-height:44px;display:flex;align-items:center}
details .grid{margin-top:8px}
#liveMsg{margin:8px 0 0;font-size:.92rem}

.best{border-radius:12px;padding:18px;background:var(--best-bg);color:var(--best-ink);display:flex;flex-direction:column;gap:6px}
.best.loss{background:var(--bestloss-bg);color:var(--bestloss-ink)}
.best small{opacity:.85;font-size:.9rem}
.best .where{font-family:var(--f-display);font-size:1.5rem;font-weight:700;line-height:1.2}
.best .big{font-family:var(--f-display);font-weight:800;font-size:clamp(2.4rem,9vw,3.6rem);line-height:1.05;font-variant-numeric:tabular-nums}
.best .meta{display:flex;flex-wrap:wrap;gap:4px 18px;font-size:.95rem}
.best .meta span{font-variant-numeric:tabular-nums}
.cards{display:flex;flex-direction:column;gap:10px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px;display:flex;flex-direction:column;gap:10px;min-width:0}
.card.top{border:2px solid var(--accent)}
.chead{display:flex;gap:12px;align-items:center}
.rank{flex:0 0 34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--field);font-family:var(--f-display);font-weight:700}
.card.top .rank{background:var(--accent);color:var(--accent-ink)}
.chead>div:nth-child(2){flex:1;min-width:0}
.chead h3{font-size:1.1rem}
.chead p{margin:0;color:var(--muted);font-size:.88rem}
.cmain{text-align:right}
.cmain small{display:block;font-size:.78rem;color:var(--muted)}
.cmain b{font-family:var(--f-display);font-size:1.35rem;font-variant-numeric:tabular-nums}
.gain{color:var(--gain)}.lossc{color:var(--loss)}
dl.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px 14px;margin:0}
dl.kv div{min-width:0}
dl.kv dt{font-size:.78rem;color:var(--muted);line-height:1.25}
dl.kv dd{margin:0;font-weight:600;font-variant-numeric:tabular-nums}
.less{margin:0;font-size:.9rem;color:var(--loss)}
.bars{display:flex;flex-direction:column;gap:12px}
.bhead{display:flex;justify-content:space-between;gap:10px;font-size:.92rem}
.bhead b{font-variant-numeric:tabular-nums}
.track{position:relative;height:14px;border-radius:7px;background:var(--field);overflow:hidden}
.track .zero{position:absolute;top:0;bottom:0;width:2px;background:var(--muted);opacity:.6}
.track .bar{position:absolute;top:0;bottom:0}
.bar.gain{background:var(--gain)}.bar.lossc{background:var(--loss)}
.tablewrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:640px;font-variant-numeric:tabular-nums;font-size:.9rem}
th,td{padding:8px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left;white-space:normal}
th{font-size:.78rem;color:var(--muted);font-weight:600}
.actions{display:flex;flex-wrap:wrap;gap:10px}
.fine{margin:0;color:var(--muted);font-size:.85rem}
</style>

<div class="shell">
  <header class="head">
    <div>
      <h1 data-i18n="title"></h1>
      <p class="tag" data-i18n="tag"></p>
    </div>
    <div class="langs" id="langs" role="group" aria-label="Language"></div>
  </header>

  <main class="cols">
    <div class="col-in">
      <section class="panel voice">
        <button class="mic" id="mic" type="button" aria-label="Voice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button>
        <div>
          <p id="heard" aria-live="polite"></p>
          <p class="hint" data-i18n="mic_hint"></p>
        </div>
      </section>

      <section class="panel">
        <h2 data-i18n="s1"></h2>
        <div class="grid">
          <label class="f"><span data-i18n="crop"></span><select id="crop"></select></label>
          <label class="f"><span data-i18n="qty"></span>
            <span class="row"><input id="qty" type="number" inputmode="decimal" min="0"><select id="unit" style="max-width:104px"></select>
            <button class="iconbtn" type="button" data-mic="qty" aria-label="Voice"></button></span></label>
        </div>
      </section>

      <section class="panel">
        <h2 data-i18n="s2"></h2>
        <div class="grid">
          <label class="f"><span data-i18n="vehicle"></span><select id="vehicle"></select></label>
          <label class="f"><span data-i18n="cap"></span><input id="cap" type="number" inputmode="decimal" min="1"></label>
          <label class="f"><span data-i18n="perkm"></span><input id="perkm" type="number" inputmode="decimal" min="0"></label>
          <label class="check"><input id="round" type="checkbox"><span data-i18n="round"></span></label>
          <label class="f"><span data-i18n="comm"></span><input id="comm" type="number" inputmode="decimal" min="0" step="0.1"></label>
          <label class="f"><span data-i18n="fee"></span><input id="fee" type="number" inputmode="decimal" min="0" step="0.1"></label>
          <label class="f"><span data-i18n="hamali"></span><input id="hamali" type="number" inputmode="decimal" min="0"></label>
          <label class="f"><span data-i18n="other"></span><input id="other" type="number" inputmode="decimal" min="0"></label>
        </div>
        <label class="f"><span data-i18n="cult"></span>
          <span class="row"><input id="cult" type="number" inputmode="decimal" min="0"><button class="iconbtn" type="button" data-mic="cult" aria-label="Voice"></button></span></label>
        <p class="fine" data-i18n="disc"></p>
      </section>

      <section class="panel">
        <h2 data-i18n="s3"></h2>
        <p class="note" data-i18n="sample_note"></p>
        <div id="mlist"></div>
        <div class="addrow">
          <label class="f"><span data-i18n="m_name"></span><input id="newName" type="text"></label>
          <label class="f"><span data-i18n="m_dist"></span><input id="newDist" type="number" inputmode="decimal" min="0"></label>
          <button class="btn alt" id="addBtn" type="button" data-i18n="add_m"></button>
        </div>
        <details>
          <summary data-i18n="live_set"></summary>
          <div class="grid">
            <label class="f"><span data-i18n="api_key"></span><input id="apiKey" type="text" autocomplete="off"></label>
            <label class="f"><span data-i18n="state_l"></span><input id="liveState" type="text"></label>
          </div>
          <p class="fine" data-i18n="live_help" style="margin-top:8px"></p>
          <div class="actions" style="margin-top:10px"><button class="btn" id="liveBtn" type="button" data-i18n="live_btn"></button></div>
          <p id="liveMsg" aria-live="polite"></p>
        </details>
      </section>
    </div>

    <div class="col-out">
      <section class="panel">
        <h2 data-i18n="s4"></h2>
        <div id="best"></div>
        <label class="f"><span><span data-i18n="whatif"></span> <b id="whatifVal"></b></span><input id="whatif" type="range" min="-15" max="15" step="1"></label>
        <div class="actions"><button class="btn" id="speakBtn" type="button"><span data-i18n="speak"></span></button></div>
      </section>
      <section class="cards" id="cards"></section>
      <section class="panel"><div class="bars" id="bars"></div></section>
      <section class="panel"><h2 data-i18n="table_t"></h2><div class="tablewrap" id="table"></div></section>
    </div>
  </main>
</div>

<script>
(function(){
/* [code, name in its own script, speech language, beta flag]. Dialects share the Hindi speech engine. */
var LANGS=[['hi','हिन्दी','hi-IN',0],['en','English','en-IN',0],['bho','भोजपुरी','hi-IN',1],['awa','अवधी','hi-IN',1],['mai','मैथिली','hi-IN',1],['chh','छत्तीसगढ़ी','hi-IN',1],['hyd','हैदराबादी','hi-IN',1],['sd','सिन्धी','hi-IN',1],['mr','मराठी','mr-IN',0],['gu','ગુજરાતી','gu-IN',0],['pa','ਪੰਜਾਬੀ','pa-IN',0],['bn','বাংলা','bn-IN',0],['or','ଓଡ଼ିଆ','or-IN',0],['te','తెలుగు','te-IN',0],['kn','ಕನ್ನಡ','kn-IN',0]];
var IX={hi:0,en:1,mr:2,gu:3,pa:4};
function sttLang(){for(var i=0;i<LANGS.length;i++){if(LANGS[i][0]===state.lang)return LANGS[i][2]}return 'hi-IN'}
/* order: hi, en, mr, gu, pa */
var S={
title:['मंडी साथी','Mandi Saathi','मंडी साथी','મંડી સાથી','ਮੰਡੀ ਸਾਥੀ'],
tag:['कहाँ बेचें, कितना मुनाफ़ा','Where to sell, and what you keep','कुठे विकायचे, किती नफा','ક્યાં વેચવું, કેટલો નફો','ਕਿੱਥੇ ਵੇਚੀਏ, ਕਿੰਨਾ ਮੁਨਾਫ਼ਾ'],
mic_hint:['माइक दबाकर बोलें, जैसे: "गेहूं 50 क्विंटल"','Tap the mic and say, for example: "wheat 50 quintal"','माईक दाबून बोला, उदा. "गहू 50 क्विंटल"','માઇક દબાવીને બોલો, જેમ કે: "ઘઉં 50 ક્વિન્ટલ"','ਮਾਈਕ ਦਬਾ ਕੇ ਬੋਲੋ, ਜਿਵੇਂ: "ਕਣਕ 50 ਕੁਇੰਟਲ"'],
listening:['सुन रहा हूँ…','Listening…','ऐकत आहे…','સાંભળું છું…','ਸੁਣ ਰਿਹਾ ਹਾਂ…'],
heard:['मैंने सुना:','I heard:','मी ऐकले:','મેં સાંભળ્યું:','ਮੈਂ ਸੁਣਿਆ:'],
novoice:['यहाँ बोलकर भरना नहीं चल पाया। अनुमति दें, या कीबोर्ड का माइक दबाकर बोलें।','Voice input did not start here. Allow the microphone, or use the microphone on your keyboard.','येथे बोलून भरता आले नाही. परवानगी द्या, किंवा कीबोर्डवरील माईक वापरा.','અહીં બોલીને ભરી શકાયું નહીં. પરવાનગી આપો, અથવા કીબોર્ડનો માઇક વાપરો.','ਇੱਥੇ ਬੋਲ ਕੇ ਭਰਨਾ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਇਜਾਜ਼ਤ ਦਿਓ, ਜਾਂ ਕੀਬੋਰਡ ਦਾ ਮਾਈਕ ਵਰਤੋ।'],
nonum:['संख्या समझ नहीं आई। अंक बोलकर देखें।','I could not catch a number. Try saying the digits.','संख्या समजली नाही. आकडे बोलून पहा.','સંખ્યા સમજાઈ નથી. અંકો બોલી જુઓ.','ਗਿਣਤੀ ਸਮਝ ਨਹੀਂ ਆਈ। ਅੰਕ ਬੋਲ ਕੇ ਵੇਖੋ।'],
s1:['आपकी फसल','Your crop','तुमचे पीक','તમારો પાક','ਤੁਹਾਡੀ ਫ਼ਸਲ'],
crop:['फसल','Crop','पीक','પાક','ਫ਼ਸਲ'],
qty:['मात्रा','Quantity','प्रमाण','જથ્થો','ਮਾਤਰਾ'],
u_q:['क्विंटल','quintal','क्विंटल','ક્વિન્ટલ','ਕੁਇੰਟਲ'],
u_kg:['किलो','kg','किलो','કિલો','ਕਿਲੋ'],
u_t:['टन','tonne','टन','ટન','ਟਨ'],
s2:['खर्चे','Your expenses','तुमचे खर्च','તમારા ખર્ચ','ਤੁਹਾਡੇ ਖ਼ਰਚੇ'],
vehicle:['गाड़ी','Vehicle','वाहन','વાહન','ਗੱਡੀ'],
v_tempo:['छोटा हाथी / टेम्पो','Tempo (small truck)','टेम्पो','ટેમ્પો','ਟੈਂਪੋ'],
v_tractor:['ट्रैक्टर-ट्रॉली','Tractor trolley','ट्रॅक्टर-ट्रॉली','ટ્રેક્ટર-ટ્રોલી','ਟਰੈਕਟਰ-ਟਰਾਲੀ'],
v_truck:['ट्रक','Truck','ट्रक','ટ્રક','ਟਰੱਕ'],
cap:['एक फेरे में क्विंटल','Load per trip (quintal)','एका फेरीत क्विंटल','એક ફેરામાં ક્વિન્ટલ','ਇੱਕ ਗੇੜੇ ਵਿੱਚ ਕੁਇੰਟਲ'],
perkm:['किराया ₹ प्रति किमी','Hire cost ₹ per km','भाडे ₹ प्रति किमी','ભાડું ₹ પ્રતિ કિમી','ਕਿਰਾਇਆ ₹ ਪ੍ਰਤੀ ਕਿਮੀ'],
round:['आना-जाना दोनों का किराया','Pay for the return trip too','जाऊन-येऊन दोन्हीचे भाडे','જવા-આવવા બંનેનું ભાડું','ਜਾਣ-ਆਉਣ ਦੋਵਾਂ ਦਾ ਕਿਰਾਇਆ'],
