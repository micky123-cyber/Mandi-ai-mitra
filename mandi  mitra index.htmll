/* spoken result, one sentence template per language that is not covered by the five base ones */
var SAY={
bn:function(m,c,q,n,p,pr,cu){return `সবচেয়ে ভালো জায়গা ${m}। ${q} কুইন্টাল ${c} বেচে, সব খরচের পর ${n} টাকা হাতে পাবেন। `+(cu?(pr?`এর মধ্যে ${p} টাকা লাভ।`:`কিন্তু ${p} টাকা ক্ষতি।`):'')},
or:function(m,c,q,n,p,pr,cu){return `ସବୁଠୁ ଭଲ ଜାଗା ${m}। ${q} କ୍ୱିଣ୍ଟାଲ ${c} ବିକି, ସବୁ ଖର୍ଚ୍ଚ ପରେ ${n} ଟଙ୍କା ହାତକୁ ଆସିବ। `+(cu?(pr?`ଏହା ମଧ୍ୟରୁ ${p} ଟଙ୍କା ଲାଭ।`:`କିନ୍ତୁ ${p} ଟଙ୍କା କ୍ଷତି।`):'')},
te:function(m,c,q,n,p,pr,cu){return `ఉత్తమమైన చోటు ${m}. ${q} క్వింటాళ్ల ${c} అమ్మితే, అన్ని ఖర్చుల తర్వాత ${n} రూపాయలు చేతికి వస్తాయి. `+(cu?(pr?`అందులో ${p} రూపాయలు లాభం.`:`కానీ ${p} రూపాయలు నష్టం.`):'')},
kn:function(m,c,q,n,p,pr,cu){return `ಉತ್ತಮ ಸ್ಥಳ ${m}. ${q} ಕ್ವಿಂಟಾಲ್ ${c} ಮಾರಿದರೆ, ಎಲ್ಲಾ ಖರ್ಚಿನ ನಂತರ ${n} ರೂಪಾಯಿ ಕೈಗೆ ಬರುತ್ತದೆ. `+(cu?(pr?`ಅದರಲ್ಲಿ ${p} ರೂಪಾಯಿ ಲಾಭ.`:`ಆದರೆ ${p} ರೂಪಾಯಿ ನಷ್ಟ.`):'')},
bho:function(m,c,q,n,p,pr,cu){return `सबसे बढ़िया जगह ${m} बा। ${q} क्विंटल ${c} बेच के, सब खर्चा के बाद ${n} रुपिया हाथ में आई। `+(cu?(pr?`एमे ${p} रुपिया मुनाफा बा।`:`बाकिर ${p} रुपिया नुकसान बा।`):'')},
awa:function(m,c,q,n,p,pr,cu){return `सबते नीक जगह ${m} है। ${q} क्विंटल ${c} बेचि कै, सब खर्चा के बाद ${n} रुपया हाथ मा आई। `+(cu?(pr?`यहमा ${p} रुपया मुनाफा है।`:`लेकिन ${p} रुपया नुकसान है।`):'')},
mai:function(m,c,q,n,p,pr,cu){return `सभसँ नीक जगह ${m} अछि। ${q} क्विंटल ${c} बेचि कऽ, सभ खर्चक बाद ${n} टाका हाथ मे आओत। `+(cu?(pr?`एहि मे ${p} टाका मुनाफा अछि।`:`मुदा ${p} टाका नोकसान अछि।`):'')},
chh:function(m,c,q,n,p,pr,cu){return `सबले बढ़िया जगा ${m} हे। ${q} क्विंटल ${c} बेच के, सब खरचा के बाद ${n} रुपिया हाथ म आही। `+(cu?(pr?`एमा ${p} रुपिया मुनाफा हे।`:`फेर ${p} रुपिया नुकसान हे।`):'')},
hyd:function(m,c,q,n,p,pr,cu){return `सबसे अच्छी जगह ${m} है। ${q} क्विंटल ${c} बेचके, सारे खर्चे के बाद ${n} रुपये हाथ में आएंगे। `+(cu?(pr?`इसमें ${p} रुपये मुनाफ़ा है।`:`लेकिन ${p} रुपये का नुकसान है।`):'')}
};
